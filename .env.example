# ExamPro environment — PLACEHOLDERS ONLY.
# Real values are LOCAL ONLY and must never be committed:
#   - the live anon key lives in the Supabase dashboard (Project Settings -> API)
#   - the access token is generated at supabase.com/dashboard/account/tokens
#   - the DB password is set in the Supabase dashboard (Database settings)
#   - test credentials are in .env.e2e.local / .test-creds.env (gitignored)
#
# Copy this file to your CI/deploy settings and fill the real values there.

SITE_URL=https://exampropaper.vercel.app
PRODUCTION_URL=https://exampropaper.vercel.app
SUPABASE_URL=your-project.supabase.co
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_TEST_EMAIL=test@example.com
SUPABASE_TEST_PASSWORD=TestPass123!

# --- Test role accounts (created by scripts/seed-test-users.mjs) ------------
# Actual generated passwords are written to .env.local (gitignored) — NEVER
# commit real values. Emails are deterministic; only passwords are secret.
TEST_SUPER_ADMIN_EMAIL=superadmin@exampro.local
TEST_SUPER_ADMIN_PASSWORD=
TEST_INSTITUTION_ADMIN_EMAIL=institution.admin@exampro.local
TEST_INSTITUTION_ADMIN_PASSWORD=
TEST_TEACHER_EMAIL=teacher@exampro.local
TEST_TEACHER_PASSWORD=
TEST_SUBJECT_TEACHER_EMAIL=subject.teacher@exampro.local
TEST_SUBJECT_TEACHER_PASSWORD=
TEST_QUESTION_REVIEWER_EMAIL=reviewer@exampro.local
TEST_QUESTION_REVIEWER_PASSWORD=
TEST_CONTENT_EDITOR_EMAIL=editor@exampro.local
TEST_CONTENT_EDITOR_PASSWORD=
TEST_STUDENT_EMAIL=student@exampro.local
TEST_STUDENT_PASSWORD=
TEST_PARENT_EMAIL=parent@exampro.local
TEST_PARENT_PASSWORD=
TEST_FINANCE_EMAIL=finance@exampro.local
TEST_FINANCE_PASSWORD=
TEST_SUPPORT_EMAIL=support@exampro.local
TEST_SUPPORT_PASSWORD=
